# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL / Supabase connection string.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Resend (customer email/SMS notifications) -- see backend/notifications/README.md.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Bar 185 <onboarding@resend.dev>"

# Stripe TEST MODE keys for the A$10 booking deposit (Checkout + webhook).
# STRIPE_SECRET_KEY: Dashboard -> Developers -> API keys -> Secret key (test mode).
# STRIPE_WEBHOOK_SECRET: printed by `stripe listen` (CLI, local dev) or by
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret (deployed).
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
